# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# The script-src hash matches the small theme script in the <head> of every page.
# If you edit that script, the browser will block it until you update the hash
# (the console error tells you the new value).
# static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics.
# challenges.cloudflare.com is already allowed, so turning Turnstile on needs no header change.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-1EdKIt/6wjJyUej9QD28r1qqGcpAHsxvrjWGCue8nAQ=' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/api/*
  Cache-Control: no-store
